<view class="page">
  <view class="page-title">市场指数</view>
  <view class="subtitle">跟踪股票情绪、股票波动率、债券波动率与美国长期利率。</view>
  <view class="range-toolbar">
    <button wx:for="{{ranges}}" wx:key="key" class="range-button {{selectedRange === item.key ? 'active' : ''}}" data-range="{{item.key}}" bindtap="selectRange">
      {{item.label}}
    </button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在获取指数历史…</view>
  <block wx:else>
    <view wx:for="{{cards}}" wx:key="code" class="card index-card">
      <view class="muted">{{item.definition.symbol}}</view>
      <view class="card-title">{{item.definition.name}}</view>
      <view class="row metric-row">
        <view class="metric">{{item.latestText}}{{item.definition.unit}}</view>
        <view class="{{item.trendClass}}">{{item.changeText}}</view>
      </view>
      <view class="muted">更新时间：{{item.observedText}} · {{item.sourceText}}</view>
      <view wx:if="{{!item.series.length}}" class="empty">暂无该时间区间的历史数据</view>
      <index-chart wx:else points="{{item.series}}" height="200" />
      <view class="description">{{item.definition.description}}</view>
      <view class="link" data-url="{{item.definition.source_url}}" bindtap="copySource">复制数据来源</view>
    </view>
    <view class="card">
      <view class="row-between">
        <view class="card-title">AI 简要分析</view>
        <button class="primary analyze-button" loading="{{analyzing}}" bindtap="analyze">分析最新走势</button>
      </view>
      <view wx:if="{{analysis}}" class="content-text">{{analysis.content}}</view>
      <view wx:else class="empty">配置 DeepSeek Key 后，可根据四项指数生成综合风险分析。</view>
    </view>
  </block>
</view>
