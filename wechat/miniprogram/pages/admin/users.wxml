<view class="page">
  <view class="page-title">用户审核</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{!items.length}}" class="empty">暂无注册用户</view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="row-between">
      <view>
        <view class="card-title">{{item.display_name || "未设置昵称"}}</view>
        <view class="muted">{{item.openid_masked}} · {{item.createdText}}</view>
      </view>
      <view class="tag">{{item.status}} / {{item.role}}</view>
    </view>
    <view class="row wrap actions">
      <button class="primary compact" data-id="{{item.id}}" data-status="active" data-role="user" bindtap="setStatus">批准用户</button>
      <button class="secondary compact" data-id="{{item.id}}" data-status="active" data-role="admin" bindtap="setStatus">设为管理员</button>
      <button class="danger compact" data-id="{{item.id}}" data-status="disabled" data-role="{{item.role}}" bindtap="setStatus">停用</button>
    </view>
  </view>
</view>
