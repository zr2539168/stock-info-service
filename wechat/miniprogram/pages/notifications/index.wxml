<view class="page">
  <view class="row-between header-row">
    <view class="page-title">通知中心</view>
    <button class="primary subscribe" loading="{{subscribing}}" bindtap="subscribe">开启微信通知</button>
  </view>
  <view class="subtitle">所有提醒都会保存在这里；微信订阅消息需要你主动授权，每次成功发送会消耗一次授权。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{!items.length}}" class="empty">暂无通知</view>
  <view wx:for="{{items}}" wx:key="id" class="card notification {{item.read_at ? '' : 'unread'}}" data-id="{{item.id}}" bindtap="open">
    <view class="row-between">
      <view class="card-title">{{item.title}}</view>
      <view class="tag">{{item.statusText}}</view>
    </view>
    <view class="content-preview">{{item.content}}</view>
    <view class="muted">{{item.createdText}}</view>
  </view>
</view>
